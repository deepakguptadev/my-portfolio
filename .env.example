# Public site URL (canonical links, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://example.com

# Resume PDF hosted elsewhere; when unset, public/resume/deepak-gupta-resume.pdf is served
NEXT_PUBLIC_RESUME_URL=

# Contact form → Google Sheet (free). The Apps Script also emails you each message.
# Setup steps are at the top of scripts/google-apps-script/contact-sheet.gs.
# Secret: any long random string, e.g. `openssl rand -hex 32`; the same value goes in the script.
CONTACT_SHEET_URL=
CONTACT_SHEET_SECRET=

# Contact form → email via Resend (optional; a second copy if the sheet is also set up).
# The form renders when the sheet, or CONTACT_TO_EMAIL plus a transport, is configured.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
# "console" logs messages instead of sending (local dev / e2e tests)
EMAIL_TRANSPORT=

# Show /design-system in a production build
SHOW_DESIGN_SYSTEM=

# Analytics: "vercel" enables Vercel Analytics + Speed Insights; empty disables
NEXT_PUBLIC_ANALYTICS=
